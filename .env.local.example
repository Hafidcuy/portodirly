# ---------------------------------------------------------------------------
# Salin file ini menjadi `.env.local` lalu isi nilainya di dashboard Supabase.
#   Project Settings -> API
# ---------------------------------------------------------------------------
# Project Supabase: portodirly
#   https://supabase.com/dashboard → project portodirly → Project Settings → API

# URL project Supabase kamu (sudah terisi, tidak perlu diubah)
SUPABASE_URL=https://fhqejileaizmxjiolqct.supabase.co

# Service role key (RAHASIA — jangan pernah commit / bagikan ke siapapun)
#   Dashboard Supabase → Project Settings → API → `service_role` secret
SUPABASE_SERVICE_ROLE_KEY=

# Password untuk masuk ke /admin
ADMIN_PASSWORD=

# Kata acak panjang untuk menandatangani cookie sesi admin.
# Contoh cara membuat:  openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Opsional
# ---------------------------------------------------------------------------

# Ganti bila ingin memakai bucket Storage lain
SUPABASE_BUCKET=portfolio-assets
